// 26.03.03
// 일단, M1+SPC(韓), M2+SPC(英) 로 전환되게끔 만들어놨다.
// 키감을 극복하느냐가 관건.
// 자세한 사항은 Obsidian 'Hardware/ZMK 한영(韓英) 전환 방식' 을 읽어봐.

// 아래도 마우스 관련 설정.
// #define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

// Layer 이름 정의
#define DV 0    // Dvorak Layer
#define QT 1    // Qwerty Layer
#define FN 2    // Function Layer
#define ETC 3    // ETC Layer
#define KPD 4    // Keypad Layer

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
// #include <dt-bindings/zmk/pointing.h>  // 마우스 기능 흉내낼 때 사용.
#include <dt-bindings/zmk/rgb.h>
// backlight 가 정확히 뭘하는 건진 모르겠는데, 이걸 켜면 Display 가 안보이게 된다.
// 키보드에 불이 들어오진 않는다.
//#include <dt-bindings/zmk/backlight.h>

// &mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

// &msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

// &msc {
//     acceleration-exponent = <1>;      // 0
//     time-to-max-speed-ms = <100>;       // 300
//     delay-ms = <0>;                   // 0
// };
//
// &mmv {
//     time-to-max-speed-ms = <500>;
//     acceleration-exponent = <1>;
//     trigger-period-ms = <16>;
// };

&soft_off { hold-time-ms = <2000>; };

/ {
    // 이건 나한테 없는듯? msc 는 마우스 스크롤을 말하는 건데..?
    // scroll_encoder: scroll_encoder {
    //     compatible = "zmk,behavior-sensor-rotate";
    //     #sensor-binding-cells = <0>;
    //     bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
    //
    //     tap-ms = <100>;
    // };

    behaviors {
      gresc: grave_escape { // 구글에서 찾음. 그냥 누르면 ESC; Shift+ESC:`(Grave)
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

      bs_del: backspace_delete { // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/mod-morph
                                   // 그냥 BS; LSHFT+BS:Del; RSHFT+BS: RSHFT + Del.
                                   // mac 이 이런 방식이지 않나..?
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

      // sh_spc: shift_space_kor_eng { // shift+space 로 한/영 전환. 여기는 그냥 shift+space 를 인식만 하게끔 하고,
      //                               // 실제 전환은 매크로에서.
      //       compatible = "zmk,behavior-mod-morph";
      //       #binding-cells = <0>;
      //       bindings = <&kp SPACE>; <&han_eng>;
      //       mods = <(MOD_LSFT)>;
      // };

      // 이유는 모르겠으나, 이거 잘 안된다.
      // 이걸 CapsLock 쪽에 넣어놨었는데, Sofle 에선 잘 작동하지 않는다.
      // 딱 첫글자에만 작동한다.
      // 오히려 연결해놨던 Feker 나 Logitech 에선 제대로 작동했다. 뭐지..??
      // 뭔가 다른 설정과 충돌을 하는듯..? release-after-ms 를 2초로 늘려도 마찬가지.
      // quick-release 를 해주나 안해주나 결과는 같다. 즉, 안된다.
      skqr: sticky_key_quick_release { // 잘 안됨!
          compatible = "zmk,behavior-sticky-key";
          label = "STICKY_KEY_QUICK_RELEASE";
          #binding-cells = <1>;
          bindings = <&kp>;
          release-after-ms = <1000>;
          quick-release;
          ignore-modifiers;
        };

      shcp: shift_capslock { // 한번 shift, 두번은 CapsLock. 0.2sec 이므로 상당히 빠르게 눌러야 한다.
          compatible = "zmk,behavior-tap-dance";
          #binding-cells = <0>;
          tapping-term-ms = <200>;
          bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        // Caps word: 영문자/숫자를 입력할 동안은 Capital lock ON. 이후 특정 키가 입력되면 Caps Lock Off.
      cpwd: caps_word {
          compatible = "zmk,behavior-caps-word";
          label = "CAPS_WORD";
          #binding-cells = <0>;
          continue-list = <UNDERSCORE MINUS>; // 이 키들은 Caps-Word 를 깨뜨리지 않음.
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;   // Q S Z 동시에 누르면 Soft Off 진입.
        };
    };

    macros {
      // 정확히는 모르겠으나, Shift + 마우스 가운데클릭인 듯.. 정의만 돼 있고 쓰이진 않았다.
        // SHIFT_MCLK: SHIFT_MCLK {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     bindings =
        //         <&macro_press>,
        //         <&kp LEFT_SHIFT>,
        //         <&macro_press>,
        //         <&mkp MB3>,
        //         <&macro_pause_for_release>,
        //         <&macro_release>,
        //         <&kp LEFT_SHIFT &mkp MB3>;
        //
        //     label = "SHIFT_MCLK";
        // };


        // QMK lm 명령 구현. (이게 기본 지원이 안되냐..?)
        // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/macros#layer-activation--more
        // 쓰기는 하겠지만, 코드를 이해하진 못하겠네. --> 이제 이해된다. Obsidian, 아래 항목을 봐.
        // 사용: %lm QT LCTRL
      lm: layer_modifier {
          compatible = "zmk,behavior-macro-two-param";
          wait-ms = <0>;
          tap-ms = <0>;
          #binding-cells = <2>; // 이게 2 라는 의미는 Obsidian 'Hardware/ZMK binding-cells 의미 ' 을 봐.
          bindings
              = <&macro_param_1to1>
              , <&macro_press &mo MACRO_PLACEHOLDER>
              , <&macro_param_2to1>
              , <&macro_press &kp MACRO_PLACEHOLDER>
              , <&macro_pause_for_release>
              , <&macro_param_2to1>
              , <&macro_release &kp MACRO_PLACEHOLDER>
              , <&macro_param_1to1>
              , <&macro_release &mo MACRO_PLACEHOLDER>
              ;
      };

      han_eng: hangul_english_change { // 한글에서 영문으로.
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          tap-ms = <10>; // 키를 연달아 보낼 땐 tap-ms 가 꼭 있어야 하는 듯.. 없으면 오류발생.
          bindings = <&to DV>, <&kp INT4>;
      };

      eng_han: english_hangul_change { // 한글에서 영문으로.
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          tap-ms = <10>; // 키를 연달아 보낼 땐 tap-ms 가 꼭 있어야 하는 듯.. 없으면 오류발생.
          bindings = <&to QT>, <&kp LANG1>;
      };

    };

    /* // 이게 되면, 일반 방법(&to, &tog 등)으로는 전환이 안된다.
    conditional_layers { // 그냥 연습용으로 만들어봤음. Fn/ETC 레이어가 동시에 켜지면, Keypad 가 활성화된다. 물론, 누르고 있는 동안만.
        compatible = "zmk,conditional-layers";
        try_layers {
          if-layers = <2 3>;
          then-layer = <4>;
        };
    }; */

    // Layer 는 아래에 표기된 순서대로 번호가 매겨진다. 차례대로 Layer 0, Layer 1, Layer 2 ... 순.
    // &trans : 하위 레이어의 그 자리를 그대로.
    // &none  : 키 무시.
    keymap {
        compatible = "zmk,keymap";

        Dvorak_layer { // Layer 0
            bindings = <
&gresc      &kp N1        &kp N2       &kp N3       &kp N4    &kp N5       &none     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0      &bs_del
&kp TAB     &kp APOS      &kp COMMA    &kp DOT      &kp P     &kp Y        &none     &kp F      &kp G      &kp C      &kp R      &kp L       &kp BSLH
&cpwd       &kp A         &kp O        &kp E        &kp U     &kp I        &none     &kp D      &kp H      &kp T      &kp N      &kp S       &kp MINUS
&shcp       &kp SEMI      &kp Q        &kp J        &kp K     &kp X        &none     &kp B      &kp M      &kp W      &kp V      &kp Z       &kp RSHFT
&none       &lm QT LCTRL  &lm QT LGUI  &lm QT LALT  &mo FN    &kp SPACE    &none     &kp SPACE  &kp ENTER  &mo ETC    &kp RSHFT  &kp DEL
            >;

            // sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; // 이건 아마도 내 거엔 필요 없을 듯?
            display-name = "Dvorak";
        };

        Qwerty_layer { // Layer 1, QT Layer
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4     &kp N5       &none     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0      &bs_del
&kp TAB     &kp Q      &kp W         &kp E         &kp R      &kp T        &none     &kp Y      &kp U      &kp I      &kp O      &kp P       &kp BSLH
&skqr LSHFT &kp A      &kp S         &kp D         &kp F      &kp G        &none     &kp H      &kp J      &kp K      &kp L      &kp SEMI    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V      &kp B        &none     &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH    &kp ENTER
&none       &kp LCTRL  &kp LGUI      &kp LALT      &mo FN     &kp SPACE    &none     &kp SPACE  &kp ENTER  &mo ETC    &kp RSHFT  &kp DEL
            >;

            // sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>; // 이건 아마도 내 거엔 필요 없을 듯?
            display-name = "Qwerty";
        };

        Function_layer { // Layer 2, FN Layer
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5        &none      &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &kp F11
&kp TILDE   &tog QT          &trans          &trans           &trans           &trans        &none      &kp PG_UP        &kp HOME         &kp UP      &kp END    &kp MINUS         &kp EQUAL
&tog KPD    &trans           &trans          &trans           &trans           &trans        &none      &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &trans           &trans          &trans           &trans           &trans        &none      &trans           &trans           &kp INSERT  &kp PSCRN  &kp F12           &trans
&none       &trans           &trans          &trans           &trans           &trans        &none      &eng_han         &trans           &trans      &trans     &trans
            >;

            display-name = "Function";
            // sensor-bindings = <&scroll_encoder>;
        };
        // &bootloader/&sys_reset/&soft_off 등은 오른쪽에선 잘 작동하지 않는다. 따라서 굳이 넣어놓을 필요가 없다.
        // 처음엔 오른쪽 끝 키들에 배열했었다.
        ETC_Layer { // Layer 3
            bindings = <
&bootloader  &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none    &kp F6           &kp F7           &kp F8           &kp LBRC         &kp RBRC         &trans
&sys_reset   &bt BT_CLR     &bt BT_CLR_ALL  &trans        &trans        &trans          &none    &trans           &trans           &kp F11          &kp F12          &kp UNDER        &rgb_ug RGB_BRI
&soft_off    &out OUT_USB   &out OUT_BLE    &trans        &trans        &trans          &none    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD
&trans       &bt BT_DISC 0  &trans          &trans        &trans        &trans          &none    &kt INT4         &kp LANG1        &trans           &trans           &trans           &trans
&none        &trans         &trans          &trans        &trans        &han_eng        &none    &trans           &eng_han         &trans           &kp LANG2        &kp INT2
            >;

            display-name = "ETC";
            // sensor-bindings = <&scroll_encoder>;
        };

        KeyPad_Layer { // Layer 4, Number Keypad Layer
            bindings = <
/* &trans  &trans       &trans        &trans           &trans         &trans     &none    &trans      &trans     &trans     &trans     &trans           &trans
&trans  &trans       &kp COMMA     &kp KP_DOT       &trans         &trans     &none    &kp KP_NUM  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS      &kp KP_MINUS
&trans  &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans     &none    &trans      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans  &trans       &trans        &kp K_CALC       &trans         &trans     &none    &kp KP_N0   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL     &kp KP_DOT
&none   &trans       &trans        &trans           &mo FN         &trans     &none    &trans      &trans     &mo ETC    &trans     &trans */

&trans  &trans       &trans        &trans           &trans         &trans     &none    &trans      &trans     &trans     &trans     &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans  &trans       &kp COMMA     &kp KP_DOT       &trans         &trans     &none    &kp KP_NUM  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS      &kp KP_MINUS
&trans  &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans     &none    &trans      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_DOT       &trans
&trans  &trans       &trans        &kp K_CALC       &trans         &trans     &none    &kp KP_N0   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL     &trans
&none   &trans       &trans        &trans           &mo FN         &trans     &none    &trans      &trans     &mo ETC    &trans     &trans
            >;

            display-name = "Keypad";
            // sensor-bindings = <&scroll_encoder>;
        };

        /* layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            // sensor-bindings = <&scroll_encoder>;
        }; */
    };
};


